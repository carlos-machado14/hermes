# Hermes V1 local-only profile
# Copy the relevant keys into ~/.hermes/config.yaml or apply them with hermes config set.

model:
  default: qwen3:1.7b
  provider: custom
  base_url: http://127.0.0.1:11434/v1
  context_length: 8192

cron:
  model: qwen3:1.7b
  model_provider: custom
  wrap_response: false

fallback_providers: []
