# Hermes/Freud V1 hybrid profile
#
# Main intelligence: OpenCode Go / MiMo-V2.5
# Local fast-path: Ollama / Qwen3.5 2B, only for explicit simple reminder/routine actions
# Simple reminders execute as native no-agent cron jobs (zero LLM calls at fire time).
# Jev (TypeSafe) is optional and used for fast typed workflow decisions when configured.

model:
  default: mimo-v2.5
  provider: opencode-go
  base_url: https://opencode.ai/zen/go/v1
  api_mode: chat_completions

fallback_providers: []

timezone: America/Sao_Paulo

agent:
  execution_guidance: compact
  skills_prompt_mode: false

cron:
  wrap_response: false

# Keep file/terminal tools ambient. This is intentional: on Telegram the model must be able
# to create an artifact and then return MEDIA:/absolute/path so the native gateway uploads it.
# Deferring these tools caused smaller models to incorrectly claim that file creation was unavailable.
tools:
  tool_search:
    enabled: on
    listing: off
    search_default_limit: 5
    max_search_limit: 10
    defer:
    - web_search
    - web_extract
    - process_manage
    - vision_analyze
    - image_generate
    - skills_list
    - skill_view
    - skill_manage
    - browser_navigate
    - browser_snapshot
    - browser_click
    - browser_type
    - browser_scroll
    - browser_back
    - browser_press
    - browser_get_images
    - browser_vision
    - browser_console
    - browser_cdp
    - browser_dialog
    - browser_vault_list
    - browser_vault_unlock
    - browser_vault_fill
    - browser_vault_save_login
    - browser_vault_enter_code
    - browser_exec
    - text_to_speech
    - todo_list
    - memory
    - session_search
    - execute_code
    - delegate_task
    - cronjob_manage
    - ha_list_entities
    - ha_get_state
    - ha_list_services
    - ha_call_service
    - kanban_show
    - kanban_list
    - kanban_complete
    - kanban_block
    - kanban_request_review
    - kanban_request_changes
    - kanban_heartbeat
    - kanban_comment
    - kanban_create
    - kanban_link
    - kanban_unblock
    - kanban_attach
    - kanban_attach_url
    - kanban_attachments
    - computer_use
    - manage_connections

local_fastpath:
  enabled: true
  model: qwen3.5:2b-q4_K_M
  base_url: http://127.0.0.1:11434
  timeout_seconds: 15

jev:
  enabled: false
  base_url: https://api.typesafe.ai
  model: jev-latest
  timeout_seconds: 5
  min_confidence: 0.80
  # API key is read only from TYPESAFE_API_KEY in ~/.hermes/.env.
