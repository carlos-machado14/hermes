# Hermes/Freud V1 hybrid profile
#
# Main intelligence: OpenCode Go / MiMo-V2.5
# Local fast-path: Ollama / Qwen3.5 2B, only for explicit simple reminder/routine actions
# Simple reminders execute as native no-agent cron jobs (zero LLM calls at fire time).

model:
  default: mimo-v2.5
  provider: opencode-go
  base_url: https://opencode.ai/zen/go/v1
  api_mode: chat_completions

fallback_providers: []

timezone: America/Sao_Paulo

agent:
  execution_guidance: compact
  skills_prompt_mode: false

cron:
  # No fleet-wide model override. Existing jobs keep their creation snapshot; new agent-backed
  # jobs snapshot the current main model (MiMo). Static local reminders are no_agent.
  wrap_response: false

# Keep the base MiMo request small. All heavy capabilities remain available, but their
# schemas are disclosed only when the model searches for them. "clarify" intentionally
# remains direct because Hermes' own A/B tests show that deferring it hurts structured questions.
tools:
  tool_search:
    enabled: on
    listing: off
    search_default_limit: 5
    max_search_limit: 10
    defer:
    - web_search
    - web_extract
    - terminal
    - process_manage
    - read_file
    - write_file
    - patch
    - search_files
    - vision_analyze
    - image_generate
    - skills_list
    - skill_view
    - skill_manage
    - browser_navigate
    - browser_snapshot
    - browser_click
    - browser_type
    - browser_scroll
    - browser_back
    - browser_press
    - browser_get_images
    - browser_vision
    - browser_console
    - browser_cdp
    - browser_dialog
    - browser_vault_list
    - browser_vault_unlock
    - browser_vault_fill
    - browser_vault_save_login
    - browser_vault_enter_code
    - browser_exec
    - text_to_speech
    - todo_list
    - memory
    - session_search
    - execute_code
    - delegate_task
    - cronjob_manage
    - ha_list_entities
    - ha_get_state
    - ha_list_services
    - ha_call_service
    - kanban_show
    - kanban_list
    - kanban_complete
    - kanban_block
    - kanban_request_review
    - kanban_request_changes
    - kanban_heartbeat
    - kanban_comment
    - kanban_create
    - kanban_link
    - kanban_unblock
    - kanban_attach
    - kanban_attach_url
    - kanban_attachments
    - computer_use
    - manage_connections

local_fastpath:
  enabled: true
  model: qwen3.5:2b-q4_K_M
  base_url: http://127.0.0.1:11434
  timeout_seconds: 15
